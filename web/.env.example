# MADQAQ Sentinel M6.1 local web dashboard. Copy to .env.local and adjust if needed.
# No secrets belong here: these values are embedded in the browser bundle.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000

# Optional sampling overrides (defaults: 6 fps, 960 px, JPEG quality 0.75). Not tuned values.
# NEXT_PUBLIC_SAMPLE_FPS=6
# NEXT_PUBLIC_MAX_ANALYSIS_WIDTH=960
# NEXT_PUBLIC_JPEG_QUALITY=0.75
